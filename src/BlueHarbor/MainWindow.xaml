<Window x:Class="BlueHarbor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="BlueHarbor · 蓝牙音频接收器"
        Width="1080"
        Height="740"
        MinWidth="980"
        MinHeight="660"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="#070B12"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI"
        Icon="Assets/BlueHarbor.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource WindowGlowBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
                <RowDefinition Height="38" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid x:Name="TitleBar"
                  Grid.Row="0"
                  Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="9" Background="#0B1624">
                        <Image Source="Assets/BlueHarbor.png" Width="32" Height="32" Stretch="Uniform" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="BlueHarbor" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="蓝牙音频接收器" FontSize="10" Foreground="{StaticResource FaintBrush}"
                                   Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Border CornerRadius="9" Background="#0E1A28" BorderBrush="#1C2B3E" BorderThickness="1"
                            Padding="10,5" Margin="0,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0"
                                     Fill="{Binding LinkState, Converter={StaticResource StatusBrush}}" />
                            <TextBlock Text="{Binding StatusTitle}" FontSize="10.5"
                                       Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="MinimizeButton" Style="{StaticResource WindowButton}"
                            Click="Minimize_Click" ToolTip="最小化到托盘">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}"
                            Click="Maximize_Click" ToolTip="最大化">
                        <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                    <Button Style="{StaticResource CloseButton}"
                            Click="Close_Click" ToolTip="关闭到托盘">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main content -->
            <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,0">
                <Grid Margin="22,2,22,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left column -->
                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource HeroCard}" Padding="20,18,20,16">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="接收器" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                    <Border HorizontalAlignment="Right" CornerRadius="6" Background="#122A31"
                                            BorderBrush="#1E4A4B" BorderThickness="1" Padding="7,3">
                                        <TextBlock Text="A2DP SINK" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="#6EEAD0" />
                                    </Border>
                                </Grid>

                                <Grid Height="122" Margin="0,4,0,0">
                                    <Ellipse Width="128" Height="128"
                                             Fill="{Binding LinkState, Converter={StaticResource StatusGlow}}" />
                                    <Ellipse Width="98" Height="98" Stroke="#24405A" StrokeThickness="1" />
                                    <Ellipse Width="74" Height="74" Stroke="#1B3247" StrokeThickness="1" />
                                    <TextBlock Text="&#xE702;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="48"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding LinkState, Converter={StaticResource StatusBrush}}" />
                                    <Ellipse Width="9" Height="9" Fill="{Binding LinkState, Converter={StaticResource StatusBrush}}"
                                             HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" />
                                </Grid>

                                <TextBlock Text="{Binding StatusTitle}" Style="{StaticResource H1}"
                                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding DeviceName}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"
                                           Margin="0,5,0,0" TextTrimming="CharacterEllipsis" MaxWidth="290" />
                                <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Muted}"
                                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="292"
                                           Margin="0,8,0,0" LineHeight="18" />

                                <Button Content="{Binding ArmButtonText}"
                                        Command="{Binding ToggleArmCommand}"
                                        Style="{StaticResource AccentButton}"
                                        HorizontalAlignment="Center"
                                        MinWidth="158"
                                        Margin="0,12,0,0" />
                                <TextBlock Text="{Binding ArmButtonHint}" FontSize="10" Foreground="{StaticResource FaintBrush}"
                                           HorizontalAlignment="Center" Margin="0,6,0,0" />

                                <Border Background="#12202F" BorderBrush="#243A50" BorderThickness="1"
                                        CornerRadius="9" Padding="10,8" Margin="0,12,0,0"
                                        Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                   Foreground="{StaticResource AmberBrush}" Margin="0,1,7,0" />
                                        <TextBlock Text="{Binding StatusHint}" Style="{StaticResource Muted}"
                                                   TextWrapping="Wrap" MaxWidth="268" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="已连接时长" Style="{StaticResource Muted}" />
                                        <TextBlock Text="{Binding UptimeText}" Style="{StaticResource Mono}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right">
                                        <TextBlock Text="连接健康" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding ReconnectText}" FontSize="11.5"
                                                   Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right"
                                                   Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="170"
                                                   TextAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource Divider}" Margin="0,10" />
                                <Grid>
                                    <TextBlock Text="{Binding ConnectedSinceText}" Style="{StaticResource Muted}" />
                                    <TextBlock Text="{Binding LastEventText}" Style="{StaticResource Muted}"
                                               HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                                               MaxWidth="180" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="音质路径" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                    <Button Content="说明"
                                            Command="{Binding ShowQualityInfoCommand}"
                                            Style="{StaticResource TextButton}"
                                            HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Text="{Binding CodecText}" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" Margin="0,5,0,0" />
                                <TextBlock Text="编码由 Windows 蓝牙栈协商；aptX 需适配器驱动，LDAC 不原生支持。应用不重新编码。"
                                           Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"
                                           LineHeight="17" />
                                <TextBlock Text="输出设备" Style="{StaticResource Muted}" FontSize="10"
                                           Margin="0,8,0,0" />
                                <ComboBox ItemsSource="{Binding OutputDevices}"
                                          SelectedItem="{Binding SelectedOutputDevice, Mode=TwoWay}"
                                          DisplayMemberPath="Name"
                                          Height="27" Margin="0,3,0,0" FontSize="11"
                                          Background="#1A2433" Foreground="{StaticResource TextBrush}"
                                          BorderBrush="#31405A" />
                                <TextBlock Text="{Binding OutputStatusText}" Style="{StaticResource Muted}"
                                           FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding AacStatusText}" Style="{StaticResource Muted}"
                                               FontSize="10" TextWrapping="Wrap" Margin="0,0,8,0" />
                                    <Button Grid.Column="1" Content="启用 AAC（实验）"
                                            Command="{Binding EnableAacCommand}"
                                            Style="{StaticResource TextButton}"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding CanEnableAac, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Grid.Column="1" Content="回退 SBC"
                                            Command="{Binding DisableAacCommand}"
                                            Style="{StaticResource TextButton}"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsAacEnabled, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right column -->
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="音频源" Style="{StaticResource H2}" />
                                        <TextBlock Text="{Binding DeviceCountText}" Style="{StaticResource Muted}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                                            Command="{Binding RefreshCommand}" ToolTip="刷新已配对设备">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                    </Button>
                                </Grid>

                                <Border Style="{StaticResource Divider}" />

                                <ItemsControl ItemsSource="{Binding Devices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource DeviceCardButton}"
                                                    Command="{Binding DataContext.SelectDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Border Style="{StaticResource DeviceCard}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="42" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="18" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Width="38" Height="38" CornerRadius="12"
                                                                VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#132132" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Background" Value="#153831" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Initial}" FontSize="15" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource AccentBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>

                                                        <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}"
                                                                       FontSize="10.5" Margin="0,2,0,0"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>

                                                        <Border Grid.Column="2" CornerRadius="6" Padding="7,3"
                                                                VerticalAlignment="Center" Margin="0,0,4,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#14202F" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Background" Value="#332B18" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                            <Setter Property="Background" Value="#12352F" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Badge}" FontSize="9.5" FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>

                                                        <TextBlock Grid.Column="3" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="10" Foreground="{StaticResource FaintBrush}"
                                                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"
                                        Background="#0B1421" BorderBrush="#1A293D" BorderThickness="1"
                                        CornerRadius="12" Padding="18,16" Margin="0,2,0,4">
                                    <StackPanel>
                                        <TextBlock Text="还没有可用的手机" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="先在 Windows 设置中配对手机，手机会自动出现在这里。"
                                                   Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                        <Button Content="打开蓝牙设置"
                                                Command="{Binding OpenBluetoothSettingsCommand}"
                                                Style="{StaticResource GhostButton}"
                                                HorizontalAlignment="Left" Margin="0,12,0,0" />
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,8,0,0">
                                    <Button Content="在 Windows 中配对新手机"
                                            Command="{Binding OpenBluetoothSettingsCommand}"
                                            Style="{StaticResource TextButton}"
                                            HorizontalAlignment="Left" />
                                    <TextBlock Text="配对后无需重启应用" Style="{StaticResource Muted}"
                                               FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="稳定性与后台" Style="{StaticResource H2}" />
                                        <TextBlock Text="桌面进程常驻，不受 UWP 后台挂起影响" Style="{StaticResource Muted}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" CornerRadius="6" Background="#10251F"
                                            BorderBrush="#1E4A3D" BorderThickness="1" Padding="7,3"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="后台常驻" FontSize="9" FontWeight="SemiBold" Foreground="#6EEAD0" />
                                    </Border>
                                </Grid>

                                <Border Style="{StaticResource Divider}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Left column -->
                                    <Grid Grid.Row="0" Grid.Column="0" Margin="0,5,18,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="自动重连" FontSize="12" Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="断开后自动恢复" Style="{StaticResource Muted}"
                                                       FontSize="10" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                                      IsChecked="{Binding AutoReconnect, Mode=TwoWay}"
                                                      VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid Grid.Row="1" Grid.Column="0" Margin="0,5,18,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="开机启动" FontSize="12" Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="登录后托盘待命" Style="{StaticResource Muted}"
                                                       FontSize="10" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                                      IsChecked="{Binding AutoStart, Mode=TwoWay}"
                                                      VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid Grid.Row="2" Grid.Column="0" Margin="0,5,18,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="关闭到托盘" FontSize="12" Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="接收端继续工作" Style="{StaticResource Muted}"
                                                       FontSize="10" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                                      IsChecked="{Binding CloseToTray, Mode=TwoWay}"
                                                      VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Right column -->
                                    <Grid Grid.Row="0" Grid.Column="1" Margin="18,5,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="保持系统唤醒" FontSize="12" Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="避免睡眠断链" Style="{StaticResource Muted}"
                                                       FontSize="10" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                                      IsChecked="{Binding KeepAwake, Mode=TwoWay}"
                                                      VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid Grid.Row="1" Grid.Column="1" Margin="18,5,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="状态通知" FontSize="12" Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="连接/断开气泡" Style="{StaticResource Muted}"
                                                       FontSize="10" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                                      IsChecked="{Binding ShowNotifications, Mode=TwoWay}"
                                                      VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid Grid.Row="2" Grid.Column="1" Margin="18,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="启动时隐藏" FontSize="12" Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="直接在托盘待命" Style="{StaticResource Muted}"
                                                       FontSize="10" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                                      IsChecked="{Binding StartMinimized, Mode=TwoWay}"
                                                      VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" BorderBrush="#162231" BorderThickness="0,1,0,0" Background="#080D16">
                <Grid Margin="22,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE702;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="{StaticResource FaintBrush}" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding AdapterText}" Style="{StaticResource Muted}" FontSize="10.5"
                                   TextTrimming="CharacterEllipsis" MaxWidth="520" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding OsText}" Style="{StaticResource Muted}" FontSize="10"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Content="日志" Command="{Binding OpenLogsCommand}"
                                Style="{StaticResource TextButton}" Margin="0,0,14,0" />
                        <Button Content="复制诊断" Command="{Binding CopyDiagnosticsCommand}"
                                Style="{StaticResource TextButton}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
