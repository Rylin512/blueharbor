<Application x:Class="BlueHarbor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:BlueHarbor.Helpers"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <helpers:BoolToVisibilityConverter x:Key="VisibleWhenTrue" />
            <helpers:StatusBrushConverter x:Key="StatusBrush" />
            <helpers:StatusGlowConverter x:Key="StatusGlow" />
            <helpers:EmptyStringToVisibilityConverter x:Key="VisibleWhenText" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
